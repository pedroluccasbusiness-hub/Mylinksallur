{
  "name": "My Link Hub",
  "short_name": "My Link Hub",
  "description": "Árvores de links para agências de modelos e modelos: várias páginas, um painel, métricas de cliques.",
  "lang": "pt-BR",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#140B16",
  "theme_color": "#140B16",
  "categories": ["business", "productivity", "social"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Páginas", "url": "/app/paginas", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Métricas", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
