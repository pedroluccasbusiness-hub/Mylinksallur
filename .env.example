# Copie para .env e preencha com os dados do SEU projeto Supabase
# (Supabase > Project Settings > API). Nunca suba o .env para o Git.
# Sem estas variáveis o app roda em "modo demonstração" (dados só no navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# (ou VITE_SUPABASE_PUBLISHABLE_KEY=, se o Supabase mostrar a chave com esse nome)
